<Project>
  <PropertyGroup>
    <!-- Define a versão padrão do .NET para todos os projetos -->
    <TargetFramework>net10.0</TargetFramework>
    
    <!-- Ativa o modo Nullable globalmente -->
    <Nullable>enable</Nullable>
    <!--Dispensa using System; e similares-->
    <ImplicitUsings>enable</ImplicitUsings>
    <!--Todo warning vira erro e quebra o build-->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--Qual versão do conjunto de analisadores do .NET usar-->
    <AnalysisLevel>latest</AnalysisLevel>
    <!--Quão rigoroso é o conjunto de regras (Default, Recommended, All)-->
    <AnalysisMode>Recommended</AnalysisMode>
    <!--Faz as regras de estilo (as IDExxxx) rodarem no build, não só no editor -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Garante que o C# mais recente seja usado -->
    <LangVersion>latest</LangVersion>
    
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Informações da empresa e licença centralizadas -->
    <Authors>Codenbit</Authors>
    <Company>Codenbit Ltda</Company>
  </PropertyGroup>
</Project>